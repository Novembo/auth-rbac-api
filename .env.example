# Copie ce fichier en ".env" et renseigne les vraies valeurs.
# Ne commite JAMAIS le fichier ".env" lui-même sur GitHub.

# Local : sqlite:///./data/app.db
# Production : postgresql+psycopg://user:motdepasse@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# Génère-en une avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origines autorisées à appeler l'API (séparées par des virgules), ex. le site publié sur GitHub Pages
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
